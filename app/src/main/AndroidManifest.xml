<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Exercice 1, étape 2 (à commenter pour l'erreur 9a) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Exercice 1, étape 3 : networkSecurityConfig -->
    <application
        android:allowBackup="true"
        android:label="LocaMobile"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.AppCompat.Light.DarkActionBar">

        <activity
            android:name=".ListeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".DetailActivity" android:exported="false" />
        <activity android:name=".ConnexionActivity" android:exported="false" />
    </application>
</manifest>
